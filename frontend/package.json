{
  "name": "svoe-stroycontrol-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "lint:api": "redocly lint ../api/openapi.yaml --config ../redocly.yaml",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts package.json",
    "format:check": "prettier --check src e2e *.ts package.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@redocly/cli": "2.78.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
